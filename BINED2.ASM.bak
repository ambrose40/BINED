.model tiny
assume cs:progg

progg segment
org 100h

;----------------------------------------------------------------------------
startup proc
;At first set video resolution and page
 call set_video
;Then set default memmory variables necessary for work
 call set_defaults
;Then draw visible border (user-interface)
 call draw_border
;Then draw second part of visible border (user-interface), and go on
 mov dh,00h
 mov dl,00h
 call draw_border_bok
 mov dh,00h
 mov dl,4Fh
 call draw_border_bok
;After call reading of command line parameters
 call get_commandline
 mov byte ptr [ds:memmory+23h],00h
;Set the starting cursor coordinates 
 call set_coordinates
;At the end switch to binary mode which is default at startup
 call mode_bin
ret
startup endp

;----------------------------------------------------------------------------
add_byte proc
push ax
push bx
push cx
push dx
mov cx,[ds:memmory+12h]
add cx,01h
mov [ds:memmory+12h],cx
mov dx,[ds:memmory+18h]
mov bx,[ds:memmory+0Eh]
sub dx,01h
add bx,dx
mov al,00h
again_insert:
mov ah,al
mov al,byte ptr [bx]
mov [bx],ah
add bx,01h
cmp bx,cx
jz end_insert
jmp again_insert
end_insert:
pop dx
pop cx
pop bx
pop ax
ret
add_byte endp

;----------------------------------------------------------------------------
sub_byte proc
push ax
push bx
push cx
push dx
mov cx,[ds:memmory+12h]
sub cx,01h
mov [ds:memmory+12h],cx
mov dx,[ds:memmory+18h]
mov bx,[ds:memmory+0Eh]
sub dx,01h
add bx,dx
cmp bx,cx
jbe again_delete
add cx,01h
mov [ds:memmory+12h],cx
jmp end_delete
again_delete:
add bx,01h
mov al,byte ptr [bx]
sub bx,01h
mov [bx],al
add bx,01h
cmp bx,cx
jae end_delete
jmp again_delete
end_delete:
pop dx
pop cx
pop bx
pop ax
ret
sub_byte endp

;----------------------------------------------------------------------------
set_coordinates proc
push dx
push bx
push ax
mov byte ptr [ds:memmory+0Ch],01h
mov byte ptr [ds:memmory+0Ah],01h
mov dh,01h
mov dl,02h
mov [ds:1A00h],dx
mov ah,02h
mov bh,02h
int 10h
pop ax
pop bx
pop dx
ret
set_coordinates endp

;------------------------------------------------------------------------------
restore_coordinates proc
push dx
push bx
push ax
mov dx,[ds:1A00h]
mov ah,02h
mov bh,02h
int 10h
pop ax
pop bx
pop dx
ret
restore_coordinates endp
;----------------------------------------------------------------------------
set_video proc
push ax
mov ah,00h
mov al,03h
int 10h
mov ah,05h
mov al,02h
int 10h
pop ax
ret
set_video endp

;----------------------------------------------------------------------------
set_defaults proc
push ax
push bx
push dx
mov byte ptr [ds:memmory+00h],00h
mov byte ptr [ds:memmory+01h],00h
mov word ptr [ds:memmory+02h],0000h
mov byte ptr [ds:memmory+04h],00h
mov word ptr [ds:memmory+06h],0102h
mov byte ptr [ds:memmory+08h],00h
mov byte ptr [ds:memmory+09h],00000000b
mov byte ptr [ds:memmory+0Bh],00h

mov word ptr [ds:memmory+0Eh],0000h
mov word ptr [ds:memmory+10h],0000h
mov word ptr [ds:memmory+12h],0000h
mov word ptr [ds:memmory+14h],173Ah
mov word ptr [ds:memmory+16h],0000h
mov word ptr [ds:memmory+18h],0102h
pop dx
pop bx
pop ax
ret
set_defaults endp

;----------------------------------------------------------------------------
cls proc
push ax
push bx
push cx
push dx
;Clear screen but leave surrouning borders
mov ah,06h
mov al,16h
mov bh,02h
mov cx,0101h
mov dx,164Eh
int 10h
pop dx
pop cx
pop bx
pop ax
ret
cls endp

;----------------------------------------------------------------------------
clear_memory proc
;Call clear sreen procedure first
 call cls
;Then call set defaults procedure to erase all memmory links
 call set_defaults
;Return handle to keyboard reading
 jmp read_keyboard
ret
clear_memory endp

;----------------------------------------------------------------------------
insert proc
push ax
push bx
push cx
push dx
mov bx,[ds:memmory+0Eh]
mov [ds:memmory+10h],bx
mov bh,byte ptr [ds:memmory+23h]
cmp bh,00h
jnz skyp
mov byte ptr [ds:memmory+00h],0F1h
call read_binchar
return_toinsert:
mov dx,[ds:1A00h]
mov ch,byte ptr [ds:memmory+0Ah]
sub ch,01h
sub dl,ch
add dl,07h
mov ch,dh
sub ch,01h
mov dh,00h
mov ax,dx
mov dh,09h
div byte ptr dh
mov dl,al
mov al,ch
mov dh,08h
mul byte ptr dh
mov dh,00h
add dx,ax
mov [ds:memmory+18h],dx
call add_byte
call write_binchar
skyp:
cmp bh,01h
jnz skyp2
mov byte ptr [ds:memmory+00h],0F1h
call read_hexchar
return_toinsert2:
mov dx,[ds:1A00h]
mov ch,byte ptr [ds:memmory+0Ah]
sub ch,01h
sub dl,ch
add dl,01h
mov ch,dh
sub ch,01h
mov dh,00h
mov ax,dx
mov dh,03h
div byte ptr dh
mov dl,al
mov al,ch
mov dh,18h
mul byte ptr dh
mov dh,00h
add dx,ax
mov [ds:memmory+18h],dx
call add_byte
call write_hexchar
skyp2:
pop dx
pop cx
pop bx
pop ax
call restore_coordinates
jmp read_keyboard
ret
insert endp

;----------------------------------------------------------------------------
delete proc
push ax
push bx
push cx
push dx
mov bx,[ds:memmory+0Eh]
mov [ds:memmory+10h],bx
mov bh,byte ptr [ds:memmory+23h]
cmp bh,00h
jnz skdp
mov byte ptr [ds:memmory+00h],0E0h
call read_binchar
return_todelete:
mov dx,[ds:1A00h]
mov ch,byte ptr [ds:memmory+0Ah]
sub ch,01h
sub dl,ch
add dl,07h
mov ch,dh
sub ch,01h
mov dh,00h
mov ax,dx
mov dh,09h
div byte ptr dh
mov dl,al
mov al,ch
mov dh,08h
mul byte ptr dh
mov dh,00h
add dx,ax
mov [ds:memmory+18h],dx
call sub_byte
call write_binchar
skdp:
cmp bh,01h
jnz skdp2
mov byte ptr [ds:memmory+00h],0E0h
call read_hexchar
return_todelete2:
mov dx,[ds:1A00h]
mov ch,byte ptr [ds:memmory+0Ah]
sub ch,01h
sub dl,ch
add dl,01h
mov ch,dh
sub ch,01h
mov dh,00h
mov ax,dx
mov dh,03h
div byte ptr dh
mov dl,al
mov al,ch
mov dh,18h
mul byte ptr dh
mov dh,00h
add dx,ax
mov [ds:memmory+18h],dx
call sub_byte
call write_hexchar
skdp2:
pop dx
pop cx
pop bx
pop ax
jmp read_keyboard
ret
delete endp

;----------------------------------------------------------------------------
get_commandline proc
push ax
push bx
push dx
push cx
;Terminate filepath entered from command line with null
 mov cx,0000h
 mov cl,byte ptr [ds:0080h]
 mov bx,0081h
 add bx,cx
 mov byte ptr [bx],00h
push dx
push ax
push bx
;Copy filepath to another memmory address
 mov ax,0000h
 mov bx,0080h
 add bx,ax
 mov byte ptr dl,[bx]
 add bx,memmory+81h
 mov [bx],dl
;Copy cycle
nexxx9:
 mov bx,0082h
 add bx,ax
 mov byte ptr dl,[bx]
 add bx,memmory+80h
 mov [bx],dl
 add ax,0001h
 cmp ax,cx
 jna nexxx9
;End of copy cycle
 add bx,ax
 mov byte ptr dl,[bx]
 add bx,memmory+80h
 mov [bx],dl
pop dx
pop ax
pop bx
pop cx
pop dx
pop bx
pop ax
;Call filepath printing to screen
call write_path
ret
get_commandline endp

print_string proc
 mov AX,80  ;вычисл€ем адрес
 mul dh
 mov cx,0000h
 mov cl,dl
 add AX,cx
 shl AX,1  ;адрес в AX=160*y+2*x
 mov DI,AX
 add di,2000h
 push ES       ;сохран€ем ES
 mov AX,0B800h ;сегмент экранной пам€ти в текстовом режиме
 mov ES,AX
 Print:
  mov al,byte ptr [si]      ;загр\ужаем AL из DS:[SI]
  cmp al,00h
  jz Ready   ;да, AL=0
  mov ES:[DI],AL ;символ дл€ отображени€
  add si,01h
  add DI,1
  mov ES:[DI],bl
  add DI,1
  jmp Print
 Ready: pop ES ;восстанавливаем ES
ret
print_string endp

;----------------------------------------------------------------------------
write_path proc
push ax
push bx
push dx
push cx
;Print entered filepath to screen
 mov dh,18h
 mov dl,02h
 mov si,memmory+102h
 mov cx,0000h
 mov cl,byte ptr ds:memmory+101h
 mov bx,memmory+102h
 add bx,cx
 mov byte ptr [bx],00h
 mov bl,color
call print_string
pop cx
pop dx
pop bx
pop ax
call restore_coordinates
ret
write_path endp

;----------------------------------------------------------------------------
draw_border proc
push ax
push bx
push dx
push cx
;Draw footer
mov bl,color
 mov dh,17h
 mov dl,0h
lea si,dwn
call print_String
 mov dh,00h
 mov dl,00h
lea si,upp
call print_String
pop cx
pop dx
pop bx
pop ax
ret
draw_border endp

;----------------------------------------------------------------------------
draw_border_bok proc
push ax
push bx
push dx
push cx
draw_border_bok_begin:
;Draw piece of border
add dh,01h
mov bl,color
lea si,bok
call print_char
;Cycle of border render
cmp dh,16h
jb draw_border_bok_begin
;Check whether other side is rendered, if not then call render of second side
pop cx
pop dx
pop bx
pop ax
ret
draw_border_bok endp

;----------------------------------------------------------------------------
mode_bin proc
push ax
push bx
push dx
push cx
;Print out BIN word to show user the binary mode is switched on
 mov dh,17h
 mov dl,09h
 mov bl,color
 lea si,modabin
 call print_string
pop cx
pop dx
pop bx
pop ax
push bx
;Check which mode does user has switched from 
 mov bh,byte ptr [ds:memmory+23h]
 cmp bh,01h
 jz switch_hextobin
pop bx
;Return handle to keyboard reading
jmp read_keyboard
ret
mode_bin endp

;----------------------------------------------------------------------------
mode_hex proc
push ax
push bx
push dx
push cx
;Print out HEX word to show user the hexadecimal mode is switched on
 mov dh,17h
 mov dl,09h
 mov bl,color
 lea si,modahex
 call print_string
pop cx
pop dx
pop bx
pop ax
push bx
;Check which mode does user has switched from 
 mov bh,byte ptr [ds:memmory+23h]
 cmp bh,00h
 jz switch_bintohex
pop bx
jmp read_keyboard
ret
mode_hex endp

;----------------------------------------------------------------------------
switch_bintohex proc
pop bx
;Return handle to keyboard reading and set variable to 1-hex
 mov byte ptr [ds:memmory+23h],01h
;Set variable to F6 meaning that mode switching operation is at handle
 mov byte ptr [ds:memmory+00h],0F6h
 mov bx,[ds:memmory+0Eh]
 mov [ds:memmory+10h],bx
;Call binary characters reading procedure
 jmp read_binchar
ret
switch_bintohex endp

;----------------------------------------------------------------------------
switch_hextobin proc
pop bx
;Return handle to keyboard reading and set variable to 0-bin
 mov byte ptr [ds:memmory+23h],00h
;Set variable to F6 meaning that mode switching operation is at handle
 mov byte ptr [ds:memmory+00h],0F6h
 mov bx,[ds:memmory+0Eh]
 mov [ds:memmory+10h],bx
;Call binary characters reading procedure
 jmp read_hexchar
ret
switch_hextobin endp

;----------------------------------------------------------------------------
write_char proc
push ax
push cx
push bx
push dx
mov dx,[ds:memmory+14h]
mov bl,color
mov si,1216h
call print_char
add dl,01h
cmp dl,4Ah
jb movye
push dx
mov dx,[ds:memmory+30h]
mov bh,byte ptr [ds:memmory+23h]
cmp bh,00h
jnz skinex
add dx,0008h
skinex:
mov bh,byte ptr [ds:memmory+23h]
cmp bh,01h
jnz skinex2
add dx,0018h
skinex2:
push dx
mov dx,[ds:memmory+14h]
add dl,02h
mov [ds:memmory+37h],dx
pop dx
call write_hex_rownumber
mov [ds:memmory+30h],dx
pop dx
mov dl,02h
add dh,01h
cmp dh,17h
jnz movye
call hex_end
movye:
mov [ds:memmory+14h],dx
pop dx
pop bx
pop cx
pop ax
ret
write_char endp

print_char proc
 mov AX,80  ;вычисл€ем адрес
 mul dh
 mov cx,0000h
 mov cl,dl
 add AX,cx
 shl AX,1  ;адрес в AX=160*y+2*x
 mov DI,AX
 add di,2000h
 push ES       ;сохран€ем ES
 mov AX,0B800h ;сегмент экранной пам€ти в текстовом режиме
 mov ES,AX
 mov al,byte ptr [si]
 mov ES:[DI],AL
 add DI,1
 mov ES:[DI],bL
 add DI,1
 pop ES
ret
print_char endp


;----------------------------------------------------------------------------
write_char_number proc
push ax
push cx
push bx
push dx
;Setting position for printing
mov dx,[ds:memmory+37h]
;Printing character for row number
mov bl,color
mov si,1216h
;Adding 1 for the next position of char
call print_char
add dl,01h
mov [ds:memmory+37h],dx
pop dx
pop bx
pop cx
pop ax
ret
write_char_number endp

;----------------------------------------------------------------------------
write_hexchar proc
;Clearing the stack
 mov sp,00h
;Clearing screen for writing of new information
 call cls
push bx
push ax
push cx
push dx
;Preparations necessary for rendering only visible part of memmory to screen
 mov ax,[ds:memmory+12h]
 mov dx,[ds:memmory+0Eh]
 sub dx,0000h
 mov [ds:memmory+30h],dx
pop dx
 mov word ptr [ds:memmory+14h],0102h
 sub ax,[ds:memmory+0Eh]
;Check for completition of cycle
 cmp ax,00h
 jnz skip8
 call hex_end
 skip8:
 mov word ptr cx,0000h
 mov dx,0000h
 nekst:
 mov word ptr bx,[ds:memmory+0Eh]
push bx
;Reading byte from memmory
 add bx,cx
push ds
push si
mov si,9000h
mov ds,si
 mov byte ptr dl,[bx]
pop si
pop ds
 mov byte ptr [ds:memmory+04h],dl
pop bx
push cx
;Calling procedure for writing of hexadecimal bytes
 call write_hextoscreen
;Printing a point to separate bytes
 mov byte ptr [ds:memmory+16h],2Eh
 call write_char
pop cx
;Check for completition of cycle, if not goto next
 add word ptr cx,0001h
 cmp cx,ax
 jae skok
 call nekst
;Exit from cycle
skok:
pop cx
pop ax
pop bx
call hex_end
ret
write_hexchar endp

;----------------------------------------------------------------------------
write_binchar proc
;Clearing the stack
 mov sp,00h
;Clearing the screen
 call cls
push bx
pop bx
push bx
push ax
push cx
 mov ax,[ds:memmory+12h]
push dx
 mov dx,[ds:memmory+0Eh]
 sub dx,0000h
 mov [ds:memmory+30h],dx
pop dx
 mov word ptr [ds:memmory+14h],0102h
 sub ax,[ds:memmory+0Eh]
 cmp ax,0000h
 jnz skip9
 call hex_end
 skip9:
 mov word ptr cx,0000h
 mov dx,0000h
nekst2:
 mov word ptr bx,[ds:memmory+0Eh]
 add bx,cx
push ds
push si
mov si,9000h
mov ds,si
 mov byte ptr dl,[bx]
pop si
pop ds
 mov byte ptr [ds:memmory+04h],dl
push cx
 call write_bintoscreen
 mov byte ptr [ds:memmory+16h],2Eh
 call write_char
pop cx
 add word ptr cx,0001h
 cmp cx,ax
 jae skok2
 call nekst2
skok2:
pop cx
pop ax
pop bx
call hex_end
ret
write_binchar endp

;----------------------------------------------------------------------------
hex_end proc
;Byte writing end scope
mov byte ptr [ds:memmory+0Bh],00h
;Check whether to restore or truncate cursor coordinates
mov ch,byte ptr [ds:memmory+00h]
cmp ch,0F5h
jb toposition_correction2
call set_coordinates
toposition_correction2:
call restore_coordinates
call read_keyboard
ret
hex_end endp

;----------------------------------------------------------------------------
write_bintoscreen proc
push cx
push dx
ext:
mov dl,byte ptr [ds:memmory+04h]
mov dh,byte ptr [ds:memmory+04h]
and dl,10000000b
shl dh,1h
mov byte ptr [ds:memmory+04h],dh
cmp dl,80h
jnz gogo1
push dx
mov BYTE PTR [ds:memmory+16h],31h
call write_char
pop dx
gogo1:
cmp dl,00h
jnz gogo2
push dx
mov byte ptr [ds:memmory+16h],30h
call write_char
pop dx
gogo2:
mov cx,[ds:memmory+02h]
add cx,0001h
mov [ds:memmory+02h],cx
cmp cx,0008h
jb ext
mov word ptr [ds:memmory+02h],0000h
pop dx
pop cx
ret
write_bintoscreen endp

;----------------------------------------------------------------------------
write_hextoscreen proc
push cx
push dx
mov dh,byte ptr [ds:memmory+04h]
mov dl,dh
mov cl,4
shr dl,cl
call write_hexdigit
mov dl,dh
and dl,0Fh
call write_hexdigit
pop dx
pop cx
ret
write_hextoscreen endp

;----------------------------------------------------------------------------
write_hexdigit proc
push dx
cmp dl,0Ah    
jae hex_letter
add dl,30h
jmp write_digit
hex_letter:
add dl,37h
write_digit:
mov byte ptr [ds:memmory+16h],dl
call write_char
pop dx
ret
write_hexdigit endp

;----------------------------------------------------------------------------
write_hex_digi proc
push dx
cmp dl,0Ah    
jae hex_lette
add dl,30h
jmp write_digi
hex_lette:
add dl,37h
write_digi:
mov byte ptr [ds:memmory+16h],dl
call write_char_number
pop dx
ret
write_hex_digi endp

;----------------------------------------------------------------------------
write_hex_rownumber proc
push cx
push dx
mov dl,dh        
mov cl,4
shr dl,cl
call write_hex_digi
mov dl,dh
and dl,0Fh
call write_hex_digi
pop dx
pop cx
push cx
push dx
mov dh,dl        
mov cl,4
shr dl,cl
call write_hex_digi
mov dl,dh
and dl,0Fh
call write_hex_digi
pop dx
pop cx
ret
write_hex_rownumber endp

;----------------------------------------------------------------------------
write_hex_position proc
mov [ds:memmory+14h],173Ah
push cx
push dx
mov dl,dh        
mov cl,4
shr dl,cl
call write_hexdigit
mov dl,dh
and dl,0Fh
call write_hexdigit
pop dx
pop cx
push cx
push dx
mov dh,dl
mov cl,4
shr dl,cl
mov [ds:memmory+14h],1745h
call write_hexdigit
mov dl,dh
and dl,0Fh
call write_hexdigit
pop dx
pop cx
ret
write_hex_position endp

;----------------------------------------------------------------------------
press_down proc
push ax
push dx
push bx
mov dx,[ds:1A00h]
add dh,01h
call write_hex_position
cmp dh,16h
jb movhi
mov dh,16h
call write_hex_position
movhi:
mov ah,02h
mov bh,02h
int 10h
mov [ds:1A00h],dx
mov ah,08h
mov bh,02h
int 10h
cmp al,20h
ja gogogaga
mov dx,[ds:1A00h]
sub dh,01h
call write_hex_position
cmp dh,01h
ja movhu2
mov dh,01h
call write_hex_position
movhu2:
mov ah,02h
mov bh,02h
int 10h
gogogaga:
mov [ds:1A00h],dx
pop bx
pop dx
pop ax
jmp read_keyboard
ret
press_down endp

;----------------------------------------------------------------------------
press_right proc
push ax
push dx
push bx
mov dx,[ds:1A00h]
add dl,01h
call write_hex_position
cmp dl,4Ah
jb movdh
add dh,01h
cmp dh,16h
jb movhy
mov dh,16h
call write_hex_position
movhy:
mov dl,01h
call write_hex_position
movdh:
mov ah,02h
mov bh,02h
int 10h
mov [ds:1A00h],dx
mov ah,08h
mov bh,02h
int 10h
cmp al,20h
ja gogogog
mov dx,[ds:1A00h]
sub dl,01h
cmp dl,00h
ja movh
sub dh,01h
cmp dh,01h
ja movhe
mov dh,01h
movhe:
mov dl,4Ah
movh:
call write_hex_position
mov ah,02h
mov bh,02h
int 10h
mov [ds:1A00h],dx
jmp achto6
gogogog:
mov bh,byte ptr [ds:memmory+23h]
cmp bh,00h
jnz achto5
mov ch,byte ptr [ds:memmory+0Ah]
add ch,01h
mov byte ptr [ds:memmory+0Ah],ch
cmp ch,09h
jnz achto5
mov byte ptr [ds:memmory+0Ah],00h
mov byte ptr [ds:memmory+200h],2Eh
call record_char
achto5:
cmp bh,01h
jnz achto6
mov ch,byte ptr [ds:memmory+0Ch]
add ch,01h
mov byte ptr [ds:memmory+0Ch],ch
cmp ch,03h
jnz achto6
mov byte ptr [ds:memmory+0Ch],00h
mov byte ptr [ds:memmory+200h],2Eh
call  record_char
ACHTO6:
pop bx
pop dx
pop ax
jmp read_keyboard
ret
press_right endp



read_charbuffer proc
 mov AX,80  ;вычисл€ем адрес
 mul dh
 mov cx,0000h
 mov cl,dl
 add AX,cx
 shl AX,1  ;адрес в AX=160*y+2*x
 mov DI,AX
 add di,2000h
 push ES       ;сохран€ем ES
 mov AX,0B800h ;сегмент экранной пам€ти в текстовом режиме
 mov ES,AX
 mov al,ES:[DI]
 add DI,1
 mov ah,ES:[DI]
 add DI,1
 pop ES
ret
read_charbuffer endp


;----------------------------------------------------------------------------
press_left proc
push ax
push dx
push bx
mov dx,[ds:1A00h]
mov bh,byte ptr [ds:memmory+23h]
cmp bh,00h
jnz sledu
mov ch,byte ptr [ds:memmory+0Ah]
cmp ch,01h
jnz gotnext2
cmp dl,0Ah
jb sledu
sub dl,09h
mov byte ptr [ds:memmory+20h],09h
sledu:
mov bh,byte ptr [ds:memmory+23h]
cmp bh,01h
jnz sledu2
mov ch,byte ptr [ds:memmory+0Ch]
cmp ch,01h
jnz gotnext2
cmp dl,05h
jb sledu2
sub dl,03h
mov byte ptr [ds:memmory+20h],03h
sledu2:
jmp gatta2
gotnext2:
sub dl,01h
mov byte ptr [ds:memmory+20h],01h
gatta2:
call write_hex_position
mov ah,02h
mov bh,02h
int 10h

call read_charbuffer
mov [ds:1A00h],dx
cmp al,20h
ja gogogo
mov dx,[ds:1A00h]
