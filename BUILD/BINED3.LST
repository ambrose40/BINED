      1					 ; EZ Binary Editor 3 -- TASM, 486 real-mode DOS EXE (small-style layout).
      2					 ;
      3					 ; Assemble: TASM /m2 BINED3.ASM,BUILD\
      4					 ; Link:     TLINK /m BUILD\BINED3.OBJ,BUILD\BINED3.EXE
      5					 ;
      6					 ; The memory model and	instruction set	are independent. Explicit USE16
      7					 ; segments permit 32-bit registers without generating 32-bit DOS segments.
      8					 ; DS always addresses DGROUP except inside the	bounded	DOS transfer below.
      9					 ; File	bytes live only	in a DOS-owned allocation, never in screen memory.
     10					 ; Unless stated otherwise, general registers and FS are scratch. DS/ES	and
     11					 ; the direction flag are preserved by procedures (DF is always	clear).
     12
     13					 P486				   ; TASM 2.5 spelling of the .486 directive
     14					 DOSSEG
     15
     16					 ; Test-only DOS fault interception; release instructions remain direct	INT 21h.
     17					 DISK_INT macro
     18					 IFDEF BINED_TEST
     19					     call TestDiskInterrupt
     20					 ELSE
     21					     int 21h
     22					 ENDIF
     23					 endm
     24
     25		  = 1000		 STACK_BYTES	 equ 4096
     26		  = 8000		 MAX_PARAGRAPHS	 equ 8000h	    ; 512 KiB, subject to conventional memory
     27		  = 4000		 IO_CHUNK	 equ 4000h	    ; never cross a 64 KiB segment boundary
     28		  = 0080		 PATH_BYTES	 equ 128
     29		  = 0014		 DATA_ROWS	 equ 20
     30		  = 0002		 DATA_TOP	 equ 2
     31		  = 000A		 DATA_COLUMN	 equ 10
     32		  = 0000		 TEXT_ROW_EOF	 equ 0
     33		  = 0001		 TEXT_ROW_WRAP	 equ 1
     34		  = 0002		 TEXT_KIND_BREAK equ 2
     35		  = 0080		 TEXT_CACHE_ROWS equ 128
     36		  = 000B		 HELP_LEFT	 equ 11
     37		  = 0002		 HELP_TOP	 equ 2
     38		  = 003A		 HELP_WIDTH	 equ 58
     39		  = 0015		 HELP_HEIGHT	 equ 21
     40					 ; VGA text attributes:	background in the high nibble, foreground in the low.
     41					 ; Black backgrounds; 01h blue,	02h dark green,	05h dark purple, 0Dh purple.
     42		  = 000A		 ATTR_NORMAL	 equ 0Ah	   ; numeric data / full-screen	Text characters
     43		  = 0002		 ATTR_TITLE	 equ 02h	   ; dark-green	dialog text
     44		  = 0002		 ATTR_OFFSET	 equ 02h	   ; dark-green	row offsets
     45		  = 000D		 ATTR_SELECTED	 equ 0Dh	   ; purple selected byte / EOF	marker
     46		  = 000A		 ATTR_STATUS	 equ 0Ah	   ; green Offset / Size / Capacity labels
     47		  = 0005		 ATTR_VALUE	 equ 05h	   ; dark-purple Offset	/ Size / Capacity values
     48		  = 0007		 ATTR_FOOTER	 equ 07h	   ; light-gray	bottom line
     49		  = 000E		 ATTR_HELP_KEY	 equ 0Eh	   ; bright-yellow key names in	F1 help
     50		  = 000F		 ATTR_HEADING	 equ 0Fh	   ; bright-white editor title
     51		  = 000C		 ATTR_COLUMN	 equ 0Ch	   ; bright-red	OFFSET / DATA /	ASCII labels
     52		  = 000E		 ATTR_MODE	 equ 0Eh	   ; bright-yellow HEX / BIN / ASCII / Text mode
     53		  = 0007		 ATTR_ASCII	 equ 07h	   ; light-gray	ASCII preview
     54
     55	    0000			 _STACK	segment	para stack use16 'STACK'
     56	    0000  1000*(??)		     db	STACK_BYTES dup	(?)
     57	    1000			 _STACK	ends
