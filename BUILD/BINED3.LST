      1					 ; EZ Binary Editor 3 -- TASM, 486 real-mode DOS EXE (small-style layout).
      2					 ;
      3					 ; Assemble: TASM /m2 BINED3.ASM,BUILD\
      4					 ; Link:     TLINK /m BUILD\BINED3.OBJ,BUILD\BINED3.EXE
      5					 ;
      6					 ; The memory model and	instruction set	are independent. Explicit USE16
      7					 ; segments permit 32-bit registers without generating 32-bit DOS segments.
      8					 ; DS always addresses DGROUP except inside the	bounded	DOS transfer below.
      9					 ; File	bytes live only	in a DOS-owned allocation, never in screen memory.
     10					 ; Unless stated otherwise, general registers and FS are scratch. DS/ES	and
     11					 ; the direction flag are preserved by procedures (DF is always	clear).
     12
     13					 P486				   ; TASM 2.5 spelling of the .486 directive
     14					 DOSSEG
     15
     16		  = 1000		 STACK_BYTES	 equ 4096
     17		  = 8000		 MAX_PARAGRAPHS	 equ 8000h	    ; 512 KiB, subject to conventional memory
     18		  = 4000		 IO_CHUNK	 equ 4000h	    ; never cross a 64 KiB segment boundary
     19		  = 0080		 PATH_BYTES	 equ 128
     20		  = 0014		 DATA_ROWS	 equ 20
     21		  = 0002		 DATA_TOP	 equ 2
     22		  = 000A		 DATA_COLUMN	 equ 10
     23		  = 0000		 TEXT_ROW_EOF	 equ 0
     24		  = 0001		 TEXT_ROW_WRAP	 equ 1
     25		  = 0002		 TEXT_KIND_BREAK equ 2
     26		  = 000B		 HELP_LEFT	 equ 11
     27		  = 0002		 HELP_TOP	 equ 2
     28		  = 003A		 HELP_WIDTH	 equ 58
     29		  = 0015		 HELP_HEIGHT	 equ 21
     30					 ; VGA text attributes:	background in the high nibble, foreground in the low.
     31					 ; Black backgrounds; 01h blue,	02h dark green,	05h dark purple, 0Dh purple.
     32		  = 000A		 ATTR_NORMAL	 equ 0Ah	   ; numeric data / full-screen	Text characters
     33		  = 0002		 ATTR_TITLE	 equ 02h	   ; dark-green	dialog text
     34		  = 0002		 ATTR_OFFSET	 equ 02h	   ; dark-green	row offsets
     35		  = 000D		 ATTR_SELECTED	 equ 0Dh	   ; purple selected byte / EOF	marker
     36		  = 000A		 ATTR_STATUS	 equ 0Ah	   ; green Offset / Size / Capacity labels
     37		  = 0005		 ATTR_VALUE	 equ 05h	   ; dark-purple Offset	/ Size / Capacity values
     38		  = 0007		 ATTR_FOOTER	 equ 07h	   ; light-gray	bottom line
     39		  = 000E		 ATTR_HELP_KEY	 equ 0Eh	   ; bright-yellow key names in	F1 help
     40		  = 000F		 ATTR_HEADING	 equ 0Fh	   ; bright-white editor title
     41		  = 000C		 ATTR_COLUMN	 equ 0Ch	   ; bright-red	OFFSET / DATA /	ASCII labels
     42		  = 000E		 ATTR_MODE	 equ 0Eh	   ; bright-yellow HEX / BIN / ASCII / Text mode
     43		  = 0007		 ATTR_ASCII	 equ 07h	   ; light-gray	ASCII preview
     44
     45	    0000			 _STACK	segment	para stack use16 'STACK'
     46	    0000  1000*(??)		     db	STACK_BYTES dup	(?)
     47	    1000			 _STACK	ends
     48
     49					 DGROUP	group _DATA
     50	    0000			 _DATA segment word public use16 'DATA'
     51	    0000  0000			 pspSegment	 dw 0
     52	    0002  0000			 bufferSegment	 dw 0
     53	    0004  00000000		 bufferCapacity	 dd 0
     54	    0008  00000000		 fileSize	 dd 0
     55	    000C  00000000		 cursorOffset	 dd 0		    ; may equal	fileSize: the append position
     56	    0010  00000000		 viewOffset	 dd 0		    ; row-aligned logical offset
     57	    0014  00			 editMode	 db 0		    ; 0	= hex, 1 = binary, 2 = ASCII, 3	= Text
