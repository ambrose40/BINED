      1					 ; EZ Binary Editor 3 -- TASM, 486 real-mode DOS EXE (small-style layout).
      2					 ;
      3					 ; Assemble: TASM /m2 BINED3.ASM,BUILD\
      4					 ; Link:     TLINK /m BUILD\BINED3.OBJ,BUILD\BINED3.EXE
      5					 ;
      6					 ; The memory model and	instruction set	are independent. Explicit USE16
      7					 ; segments permit 32-bit registers without generating 32-bit DOS segments.
      8					 ; DS always addresses DGROUP except inside the	bounded	DOS transfer below.
      9					 ; File	bytes live only	in a DOS-owned allocation, never in screen memory.
     10					 ; Unless stated otherwise, general registers and FS are scratch. DS/ES	and
     11					 ; the direction flag are preserved by procedures (DF is always	clear).
     12
     13					 P486				   ; TASM 2.5 spelling of the .486 directive
     14					 DOSSEG
     15
     16		  = 1000		 STACK_BYTES	 equ 4096
     17		  = 8000		 MAX_PARAGRAPHS	 equ 8000h	    ; 512 KiB, subject to conventional memory
     18		  = 4000		 IO_CHUNK	 equ 4000h	    ; never cross a 64 KiB segment boundary
     19		  = 0080		 PATH_BYTES	 equ 128
     20		  = 0014		 DATA_ROWS	 equ 20
     21		  = 0002		 DATA_TOP	 equ 2
     22		  = 000A		 DATA_COLUMN	 equ 10
     23					 ; VGA text attributes:	background in the high nibble, foreground in the low.
     24					 ; Keep	every background black;	02h is dark green, 0Ah bright green, 0Dh purple.
     25		  = 000A		 ATTR_NORMAL	 equ 0Ah	   ; file bytes, ASCII preview,	filename
     26		  = 0002		 ATTR_TITLE	 equ 02h	   ; dark-green	title and dialog text
     27		  = 0002		 ATTR_OFFSET	 equ 02h	   ; dark-green	offsets	and column headings
     28		  = 000D		 ATTR_SELECTED	 equ 0Dh	   ; purple selected byte / EOF	marker
     29		  = 000A		 ATTR_STATUS	 equ 0Ah	   ; green position, size and status messages
     30
     31	    0000			 _STACK	segment	para stack use16 'STACK'
     32	    0000  1000*(??)		     db	STACK_BYTES dup	(?)
     33	    1000			 _STACK	ends
     34
     35					 DGROUP	group _DATA
     36	    0000			 _DATA segment word public use16 'DATA'
     37	    0000  0000			 pspSegment	 dw 0
     38	    0002  0000			 bufferSegment	 dw 0
     39	    0004  00000000		 bufferCapacity	 dd 0
     40	    0008  00000000		 fileSize	 dd 0
     41	    000C  00000000		 cursorOffset	 dd 0		    ; may equal	fileSize: the append position
     42	    0010  00000000		 viewOffset	 dd 0		    ; row-aligned logical offset
     43	    0014  00			 editMode	 db 0		    ; 0	= hexadecimal, 1 = binary
     44	    0015  00			 digitIndex	 db 0		    ; high nibble/most significant bit first
     45	    0016  02			 digitsPerByte	 db 2
     46	    0017  00000010		 bytesPerRow	 dd 16
     47	    001B  00000140		 pageBytes	 dd DATA_ROWS *	16
     48	    001F  00			 dirty		 db 0
     49	    0020  00			 quitRequested	 db 0
     50	    0021  00			 exitCode	 db 0
     51	    0022  00			 videoActive	 db 0
