    385					 ; ---------------------------------------------------------------------------
    386					 ; Startup and lifetime. Only Main owns	the event loop and termination.
    387					 ; DOSSEG puts the stack last: shrink the PSP block through its	END,
    388					 ; not through the current SP. DOS can then allocate the released paragraphs.
    389					 ; ---------------------------------------------------------------------------
    390	    0000			 Main proc
    391	    0000  B8 0000s		     mov ax,DGROUP
    392	    0003  8E D8			     mov ds,ax
    393	    0005  8C 06	0000r		     mov pspSegment,es
    394	    0009  FC			     cld
    395	    000A  E8 0075		     call AllocateBuffer
    396	    000D  73 05			     jnc main_memory_ready
    397	    000F  BA 08E8r		     mov dx,offset memoryError
    398	    0012  EB 45			     jmp FatalError
